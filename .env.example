# ── The Slayton Service — environment configuration ──────────────
# Copy to .env.local and adjust per environment. On Vercel, add the
# same variables in Project Settings → Environment Variables.

# Canonical site origin (no trailing slash). Used for metadata,
# Open Graph URLs, sitemap, robots and JSON-LD. Production must be
# the real https:// domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public contact email. Leave empty to hide email CTAs until the
# official address is confirmed.
NEXT_PUBLIC_CONTACT_EMAIL=

# ── Estimate inquiry delivery ────────────────────────────────────
# Two honest paths; configure either (Resend preferred when set).
# While both are unset, the form plainly reports that online
# requests aren't connected and routes visitors to phone/Instagram.

# Path A — Resend (https://resend.com): API key plus the mailbox
# that receives inquiries and the verified sender address.
RESEND_API_KEY=
INQUIRY_EMAIL_TO=hoster.slayton@theslaytonservice.com
INQUIRY_EMAIL_FROM=

# Path B — any webhook (Zapier, Make, n8n, future CRM endpoint).
INQUIRY_WEBHOOK_URL=

# ── Analytics & Search ───────────────────────────────────────────
# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Scripts load
# only when this is set — zero third-party requests otherwise.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console meta-tag verification token (the content
# value only, not the full tag). Rendered only when set.
GOOGLE_SITE_VERIFICATION=

# ── Admin console (/admin) ───────────────────────────────────────
# Both are required for admin sign-in; while either is missing the
# login page honestly reports that access isn't configured.
# ADMIN_PASSWORD: the owner's passphrase — long and unique.
# ADMIN_SESSION_SECRET: 32+ random characters used to sign the
# session cookie. Generate with:  openssl rand -hex 32
# Never commit real values; rotate both if ever exposed.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
